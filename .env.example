# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
PORT=
NODE_ENV=
APP_URL=
CORS_ORIGINS=

# ─────────────────────────────────────────────
# Database (PostgreSQL via Prisma)
# ─────────────────────────────────────────────
DATABASE_URL=

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRATION=

# ─────────────────────────────────────────────
# OpenAI
# ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_BASE_URL=
OPENAI_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SYNC_ENABLED=true
# Moderation-only fallback (AI-059) — live-verified that OpenRouter's OPENAI_BASE_URL does not
# proxy POST /moderations (returns its website's own 404 page, not a JSON API error). Leave both
# unset to keep moderation on the primary client above (it will fail open — see ModerationService).
# Set both to route moderation calls to a provider that does support the endpoint, e.g. real OpenAI:
#   MODERATION_API_BASE_URL=https://api.openai.com/v1
#   MODERATION_API_KEY=sk-...
MODERATION_API_BASE_URL=
MODERATION_API_KEY=
# When true, skip the network entirely and return a canned fixture response (see
# src/modules/openai/fixtures/static-moderation-responses.json) — for verifying the moderation
# pipeline end to end without billable API quota. Default false (real/live calls).
MODERATION_STATIC_MODE=false

# ─────────────────────────────────────────────
# Pinecone
# ─────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=documents

# ─────────────────────────────────────────────
# Sentry
# ─────────────────────────────────────────────
SENTRY_DSN=

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
THROTTLE_TTL=
THROTTLE_LIMIT=

# ─────────────────────────────────────────────
# Chat
# ─────────────────────────────────────────────
CHAT_MAX_CONTEXT_MESSAGES=50
CHAT_CONTEXT_WINDOW_PERCENTAGE=0.8
CHAT_TOOL_TIMEOUT_MS=10000
CHAT_HTTP_TOOL_TIMEOUT_MS=5000
CHAT_AUTO_TITLE=true
CHAT_TOOL_HTTP_ALLOWED_DOMAINS=

# ─────────────────────────────────────────────
# RAG / Embeddings
# ─────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=20
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
RAG_MAX_CONTEXT_TOKENS=4000
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ─────────────────────────────────────────────
# Moderation
# ─────────────────────────────────────────────
MODERATION_ENABLED=true
MODERATION_INPUT_ENABLED=true
MODERATION_OUTPUT_ENABLED=false
MODERATION_BLOCK_THRESHOLD=0.7

# ─────────────────────────────────────────────
# Cost Budgets
# ─────────────────────────────────────────────
COST_BUDGET_ENABLED=true
COST_BUDGET_CACHE_TTL_MS=60000

# ─────────────────────────────────────────────
# Data Retention
# ─────────────────────────────────────────────
RETENTION_AUDIT_DAYS=90
RETENTION_MODERATION_DAYS=90
RETENTION_ARCHIVED_CONVERSATION_DAYS=30
RETENTION_EMBEDDING_CACHE_DAYS=180
RETENTION_CRON=0 2 * * *
